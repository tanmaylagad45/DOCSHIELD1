# DocShield Environment Configuration Template
# Copy to .env for local development

PROJECT_NAME="DocShield Document Intelligence API"
API_V1_STR="/api/v1"
DEBUG=true
ENVIRONMENT="development"

# Database Configuration (SQLite for local development)
DATABASE_URL="sqlite:///./docshield.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# File Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# Security & Authentication (Replace with cryptographically random secret in production)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
